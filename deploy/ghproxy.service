[Unit]
Description=ghproxy - GitHub release cache proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghproxy
Group=ghproxy
WorkingDirectory=/opt/ghproxy
Environment=PYTHONPATH=/opt/ghproxy/src
EnvironmentFile=/etc/ghproxy.env
ExecStart=/opt/ghproxy/.venv/bin/gunicorn -w 1 --threads 16 --timeout 300 -b 127.0.0.1:8080 ghproxy.wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/cache/ghproxy

[Install]
WantedBy=multi-user.target
